.env
.env.*
!.env.example

# Operating-system and downloader metadata
.DS_Store
**/CACHEDIR.TAG
**/*.metadata

# Model downloads must stay under models/, not the backend package.
backend/config.json
backend/gitignore

.venv/
.runtimes/
infrastructure/vendor/**/.git/
infrastructure/vendor/**/media/
infrastructure/vendor/**/build/
infrastructure/vendor/**/*.egg-info/
infrastructure/vendor/moviepy/*
!infrastructure/vendor/moviepy/moviepy/
!infrastructure/vendor/moviepy/pyproject.toml
!infrastructure/vendor/moviepy/setup.cfg
!infrastructure/vendor/moviepy/MANIFEST.in
!infrastructure/vendor/moviepy/README.md
!infrastructure/vendor/moviepy/LICENCE.txt
infrastructure/vendor/wandb-mcp-server/*
!infrastructure/vendor/wandb-mcp-server/src/
!infrastructure/vendor/wandb-mcp-server/pyproject.toml
!infrastructure/vendor/wandb-mcp-server/README.md
!infrastructure/vendor/wandb-mcp-server/LICENSE
**/node_modules/
**/.next/
**/__pycache__/
**/.pytest_cache/

# Runtime output stays local, but the verified static cortical geometry is
# safe to share with every checkout so the anatomy view works after a clone.
data/
!data/
data/*
!data/geometry/
!data/geometry/*.json
!data/geometry/*.gii.gz

cache/
models/*
!models/*.py
!models/README.md
!models/.gitignore
tribev2-balanced-qv-local/*
!tribev2-balanced-qv-local/*.py
!tribev2-balanced-qv-local/README.md
!tribev2-balanced-qv-local/LICENSE
!tribev2-balanced-qv-local/config.yaml
!tribev2-balanced-qv-local/provenance.json
tribev2-main/
**/*.tsbuildinfo
.wandb/
wandb/
infrastructure/wheels/
artifacts/
