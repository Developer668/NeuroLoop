# Generate unique local secrets with python scripts/setup.py. Never use sample keys.
NEUROLOOP_OPERATOR_TOKEN=
NEUROLOOP_AGENT_TOKEN=
NEUROLOOP_WORKER_TOKEN=
NEUROLOOP_LOCAL_BOOTSTRAP_TOKEN=
NEUROLOOP_SIGNING_KEY=
NEUROLOOP_PUBLIC_API_URL=http://127.0.0.1:8010
NEUROLOOP_FRONTEND_ORIGIN=http://localhost:3010
NEUROLOOP_DATABASE_URL=
NEUROLOOP_STORAGE=local
NEUROLOOP_ENVIRONMENT=development
NEUROLOOP_AUTO_MIGRATE=true
NEUROLOOP_INFERENCE_MODEL=zai-org/GLM-5.3-Flash
# NEUROLOOP_REASONER_COST_CEILING_USD=0.10
# NEUROLOOP_TYPESAFE_COST_CEILING_USD=0.05
WANDB_API_KEY=
WANDB_PROJECT=
TYPESAFE_API_KEY=
NEUROLOOP_TYPESAFE_MODEL=jev-latest
NEUROLOOP_WEAVE_ENABLED=false
# Opt in to backing up original media, generated outputs, model receipts and run logs.
NEUROLOOP_WANDB_ARTIFACTS_ENABLED=false
NEUROLOOP_PROVIDER=local
NEUROLOOP_PROVIDER_WORKLOAD_APPROVED=false
# GPU notebook only; registration is lazy, execution requires starting its worker.
NEUROLOOP_ENABLE_H3=false
NEUROLOOP_ENABLE_IDEOGRAM=false
NEUROLOOP_MODEL_LONG_EDGE=1024
NEUROLOOP_MODEL_STEPS=4
NEUROLOOP_WORKER_IDLE_SECONDS=300
NEUROLOOP_VISION_MODEL=zai-org/GLM-5.3-Flash
NEUROLOOP_VISION_REVISION=operator-configured-v1
NEUROLOOP_ENABLE_LEGACY_EVALUATORS=false
NEUROLOOP_TSAM_RESEARCH_LICENSE_ACCEPTED=false
META_ACCESS_TOKEN=
NEUROLOOP_META_GRAPH_VERSION=
# Publish Ads OAuth applications. Register the callback URL shown in Settings/Publish Ads.
META_APP_ID=
META_APP_SECRET=
NEUROLOOP_META_OAUTH_REDIRECT_URI=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
NEUROLOOP_GOOGLE_ADS_API_VERSION=v25
NEUROLOOP_GOOGLE_ADS_OAUTH_REDIRECT_URI=
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
NEUROLOOP_TIKTOK_OAUTH_REDIRECT_URI=
NEUROLOOP_S3_ENDPOINT=
NEUROLOOP_S3_BUCKET=
NEUROLOOP_S3_ACCESS_KEY=
NEUROLOOP_S3_SECRET_KEY=

# CPU media tools: use PATH names or approved full executable paths.
NEUROLOOP_FFMPEG=ffmpeg
NEUROLOOP_FFPROBE=ffprobe
