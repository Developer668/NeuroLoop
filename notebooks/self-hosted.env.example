# Private worker environment. Copy to the host's secret store, not Git.
NEUROLOOP_PROVIDER=self-hosted
NEUROLOOP_PUBLIC_API_URL=https://your-neuroloop-api.example
NEUROLOOP_WORKER_TOKEN=
NEUROLOOP_ENABLE_H3=true
NEUROLOOP_ENABLE_IDEOGRAM=true
NEUROLOOP_MODEL_LONG_EDGE=1024
NEUROLOOP_MODEL_STEPS=20
NEUROLOOP_WORKER_IDLE_SECONDS=300
HF_TOKEN=
WANDB_API_KEY=
WANDB_PROJECT=
NEUROLOOP_INFERENCE_MODEL=zai-org/GLM-5.3-Flash
NEUROLOOP_VISION_MODEL=zai-org/GLM-5.3-Flash
NEUROLOOP_VISION_REVISION=
TYPESAFE_API_KEY=
NEUROLOOP_TYPESAFE_MODEL=jev-latest
# Enable only after installing the original research dependencies/checkpoints.
NEUROLOOP_ENABLE_LEGACY_EVALUATORS=false
NEUROLOOP_RESEARCH_ROOT=/workspace/NeuroLoop
NEUROLOOP_TSAM_RESEARCH_LICENSE_ACCEPTED=false
